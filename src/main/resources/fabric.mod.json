{
  "schemaVersion": 1,
  "id": "macu_lib",
  "version": "${version}",
  "name": "macu Lib",
  "description": "Common library for my mods",
  "authors": [
    {
      "name": "macuguita",
      "contact": {
        "github": "https://github.com/macuguita"
      }
    }
  ],
  "contact": {
    "homepage": "https://macuguita.com/",
    "sources": "https://github.com/macuguita/macu_lib/",
    "issues": "https://github.com/macuguita/macu_lib/issues"
  },
  "license": "EUPL-1.2",
  "icon": "assets/icon.png",
  "environment": "*",
  "entrypoints": {
    "yumi:init": [
      "com.macuguita.lib.impl.MacuLib",
      "com.macuguita.lib.impl.persista.Persista"
    ],
    "yumi:client_init": [
      "com.macuguita.lib.impl.client.MacuLibClient",
      "com.macuguita.lib.impl.persista.PersistaClient"
    ]
  },
  "mixins": [
    "macu_lib.mixins.json"
  ],
  "accessWidener": "macu_lib.classtweaker",
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "${minecraft_fabric_version_range}",
    "fabric-api": "*",
    "yumi_mc_core": ">=${yumi_version}"
  },
  "custom": {
    "modmenu": {
      "badges": [ "library" ],
      "update_checker": true
    }
  }
}
